					fileName="main.js"
				/>
				<descriptor
					id="control-x"
					name="Control X"
					extends="aws-file-upload"
					description="A control that does X"
				>
					...
				</descriptor>
			</controls>
		</configuration>
	</widget>
-->

<widget id="craftercms.components.ContentTypeManagement">
	<configuration>

		<controls id="aws-file-upload"/>
		<controls id="file-name"/>
		<controls id="input"/>
		<controls id="textarea"/>
		<controls id="control-x">
			<icon id="@mui/material-icons/CoolIconRounded"/>
			<plugin
				id="org.craftercms.plugin.control.x"
				type="authoring"
				name="controls"
				fileName="main.js"
			/>
			<!-- descriptorOverrides -->
			<descriptor
				id="control-x"
				name="Control X"
				extends="aws-file-upload"
				description="A control that does X"
			>
				<sections title="Properties">
					<fields>tokenize</fields>
					<fields>maxlength</fields>
					<fields>true</fields>
				</sections>
				<sections title="Constraints">
					<fields>required</fields>
				</sections>
				<fields>
					<maxlength
						id="maxlength"
						type="numeric-input"
						name="Max Length"
						defaultValue="100"
					/>
					<tokenize
						id="tokenize"
						type="checkbox"
						name="Tokenize"
						defaultValue="true"
					/>
				</fields>
			</descriptor>
		</controls>

		<controlExclusions>aws-file-upload</controlExclusions>

		<dataSources id="components" />
		<dataSources id="img-desktop-upload" />
		<dataSourceExclusions>aws-file-upload</dataSourceExclusions>

		<objectTypes id="root" /><!-- A system type from which all types (ootb or custom) inherit from -->
		<objectTypes id="page" />
		<objectTypes id="component" />
		<objectTypes id="type-x" extends="component">
			<!-- Defines the type's basic editable properties -->
			<properties>
				<sections title="Form Basics">
					<fields>title</fields>
					<fields>description</fields>
					...
				</sections>
				<sections title="Quick Create">
					<fields>showInQuickCreate</fields>
					<fields>quickCreateDestinationPattern</fields>
				</sections>
				<fields><!-- FE2 ContentTypeField objects -->
					<title
						id="title"
						type="input"
						name="Page URL"
					/>
					<description/>
					<showInQuickCreate/>
					<quickCreateDestinationPattern/>
				</fields>
			</properties>
			<template /><!-- Defines the type's initial sections and controls (same struct as "<properties/>" section) -->
			<baseControlFields /><!-- Defines the common field properties for this type (i.e. all controls inherit these props) -->
		</objectTypes>

	</configuration>
</widget>

<!-- To serialize to the same XML as today, we need the sections to be `properties` and `constraints` -->
<!-- Annoying: Sections don't have an id. -->
<!-- Annoying: maxlength is a property, but it should be a constraint? Can we move it to constraints? Also spelled maxlength instead of maxLength -->

<!--

Deep Merge:

	`{ validations: { required: true } }` & `{ validations: { minLength: 5 } }` = `{ validations: { required: true, minLength: 5 } }`

	Definition: Combining objects into a single object, merging properties recursively.
							If an object contains another object as a property, the properties of that inner object will also be merged.

Shallow Merge:

	`{ validations: { required: true } }` & `{ validations: { minLength: 5 } }` = `{ validations: { minLength: 5 } }`

	Definition: Combining objects into a single object, merging properties at the top level only.
							If an object contains another object as a property, the properties of that inner object will not be merged.

-->
