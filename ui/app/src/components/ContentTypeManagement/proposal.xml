===========================
Upgraded site with plugins:
===========================
	<widget id="craftercms.components.ContentTypeManagement">
		<configuration>
			<controls id="control-x">
				<icon id="@mui/material-icons/CoolIconRounded"/>
				<plugin
					id="org.craftercms.plugin.control.x"
					type="authoring"
